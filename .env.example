# .env.example — paste-and-fill config template for fanout-review
# DO NOT COMMIT real secrets. Copy to .env (chmod 600) and fill values.
# .env is listed in .gitignore and will not be tracked by git.

# ---------------------------------------------------------------------------
# Core: HMAC chain key
# ---------------------------------------------------------------------------
# Any random 32+ character string. Used to sign each JSONL receipt line.
# Rotate this before production use. The default ("") disables tamper-evidence.
# Run: python3 -c "import secrets; print(secrets.token_hex(32))" to generate one.
CHAIN_HMAC_KEY=CHANGEME_64_hex_chars_for_HMAC_SHA256_signing

# ---------------------------------------------------------------------------
# Vendor API keys — choose at least one free-tier provider to start
# ---------------------------------------------------------------------------
# OpenRouter: free tier with many models. https://openrouter.ai — recommended default.
OPENROUTER_API_KEY=CHANGEME

# Groq: fast free tier with Llama3. https://console.groq.com
GROQ_API_KEY=CHANGEME

# Together AI: free tier with open models. https://api.together.xyz
TOGETHER_API_KEY=CHANGEME

# Fireworks AI: fast inference, free tier. https://fireworks.ai
FIREWORKS_API_KEY=CHANGEME

# Anthropic (Claude): paid. https://console.anthropic.com
ANTHROPIC_API_KEY=CHANGEME

# OpenAI (GPT): paid. https://platform.openai.com
OPENAI_API_KEY=CHANGEME

# ---------------------------------------------------------------------------
# Postgres upgrade path (optional — only needed for UPGRADE_TO_POSTGRES.md)
# ---------------------------------------------------------------------------
POSTGRES_DSN=postgres://app:CHANGEME_strong_password@127.0.0.1:5432/fanout_chain
DATABASE_URL=${POSTGRES_DSN}
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGEME_strong_password
POSTGRES_DB=fanout_chain

# XTDB bitemporal mirror (optional — pair with Postgres upgrade)
XTDB_DSN=postgres://xtdb:CHANGEME_xtdb_pw@127.0.0.1:5433/xtdb_mirror

# ---------------------------------------------------------------------------
# GitHub / Codeberg mirror push (optional — only needed for push_mirror.sh)
# ---------------------------------------------------------------------------
# Generate personal access tokens scoped to a single repo (least-privilege):
#   GitHub:   github.com/settings/tokens → "contents:write" fine-grained scope
#   Codeberg: codeberg.org/user/settings/applications → "repository" scope
GITHUB_TOKEN=CHANGEME_github_pat
GITHUB_USER=CHANGEME_your_github_username
CODEBERG_TOKEN=CHANGEME_codeberg_pat
CODEBERG_USER=CHANGEME_your_codeberg_username
MIRROR_REPO_NAME=CHANGEME_repo_name   # e.g. fanout-review

# ---------------------------------------------------------------------------
# Optional: search / web enrichment
# ---------------------------------------------------------------------------
EXA_API_KEY=CHANGEME
PERPLEXITY_API_KEY=CHANGEME
TAVILY_API_KEY=CHANGEME
SERPER_API_KEY=CHANGEME

# ---------------------------------------------------------------------------
# Optional: observability (Langfuse)
# ---------------------------------------------------------------------------
LANGFUSE_HOST=http://127.0.0.1:3003
LANGFUSE_PUBLIC_KEY=CHANGEME
LANGFUSE_SECRET_KEY=CHANGEME

# ---------------------------------------------------------------------------
# Optional: request pacing (free-tier rate limit mitigation)
# ---------------------------------------------------------------------------
# Set to 2000-3000 if hitting rate limits on free-tier providers.
REQUEST_DELAY_MS=0
